generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(uuid())
  githubId            String?           @unique
  username            String            @unique
  name                String?
  email               String?
  authEmail           String?           @unique
  samlSubjectId       String?           @unique
  organizationRole    String?           @default("MEMBER")
  passwordHash        String?
  interests           String[]           @default([])
  avatar              String?
  bio                 String?
  location            String?
  company             String?
  website             String?
  githubUrl           String?
  isOnline            Boolean           @default(false)
  socialLinks         Json?
  settings            Json?
  joinedAt            DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  xpTransactions      XpTransaction[]
  activities          Activity[]
  battlesAsChallenger Battle[]          @relation("BattleChallenger")
  battlesAsOpponent   Battle[]          @relation("BattleOpponent")
  wonBattles          Battle[]          @relation("BattleWinner")
  rating              DeveloperRating?
  battleRating        BattleRating?
  stats               DeveloperStats?
  following           Follows[]         @relation("follower")
  followers           Follows[]         @relation("following")
  languages           LanguageStat[]
  notifications       Notification[]
  notificationOutbox  NotificationOutbox[]
  repositories        Repository[]
  achievements        UserAchievement[]
  badges              UserBadge[]
  challenges          UserChallenge[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  userSettings        UserSettings?
  mentorshipProfile   MentorshipProfile?
  mentorSessions      ShadowCodingSession[] @relation("MentorSessions")
  apprenticeSessions  ShadowCodingSession[] @relation("ApprenticeSessions")

    guildMemberships    GuildMember[]
  ownedGuilds         Guild[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  deviceFingerprint String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Follows {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model DeveloperRating {
  id              String   @id @default(uuid())
  userId          String   @unique
  overall         Float    @default(0)
  level           Int      @default(1)
  githubXp        Int      @default(0)
  gamificationXp  Int      @default(0)
  xp              Int      @default(0)
  xpToNextLevel   Int      @default(100)
  rank            Int      @default(0)
  totalDevelopers Int      @default(0)
  tier            Tier     @default(BRONZE)
  growthScore     Float    @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([overall, tier])
  @@index([rank])
  @@index([userId, xp(sort: Desc)])
  @@map("developer_ratings")
}

/// Competitive MMR is independent of the GitHub activity score in DeveloperRating.
model BattleRating {
  userId                    String   @id
  elo                       Float    @default(1200)
  placementMatchesRemaining Int      @default(0)
  seasonNumber              Int      @default(1)
  lastBattleAt              DateTime?
  decayPeriodsApplied       Int      @default(0)
  decayFloor                Float?
  decayWarnedFor            DateTime?
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seasonNumber, elo])
  @@index([lastBattleAt])
  @@map("battle_ratings")
}

model BattleSeason {
  number    Int       @id
  startedAt DateTime
  endsAt    DateTime
  closedAt  DateTime?
  standings SeasonArchive[]

  @@map("battle_seasons")
}

/// Snapshot names and ratings so Hall of Fame entries survive profile deletion.
model SeasonArchive {
  id          String       @id @default(uuid())
  seasonNumber Int
  playerId    String
  username    String
  finalElo    Float
  rank        Int
  tier        Tier
  archivedAt  DateTime     @default(now())
  season      BattleSeason @relation(fields: [seasonNumber], references: [number])

  @@unique([seasonNumber, playerId])
  @@index([seasonNumber, rank])
  @@map("season_archives")
}

model DeveloperStats {
  id               String   @id @default(uuid())
  userId           String   @unique
  totalCommits     Int      @default(0)
  totalPRs         Int      @default(0)
  totalIssues      Int      @default(0)
  totalReviews     Int      @default(0)
  totalStars       Int      @default(0)
  totalForks       Int      @default(0)
  totalRepos       Int      @default(0)
  followers        Int      @default(0)
  following        Int      @default(0)
  contributions    Int      @default(0)
  streak           Int      @default(0)
  longestStreak    Int      @default(0)
  avgCommitsPerDay Float    @default(0)
  activeDays       Int      @default(0)
  updatedAt        DateTime @updatedAt
  contributionData Json?
  commitActivity   Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("developer_stats")
}

model Repository {
  id            String   @id @default(uuid())
  githubRepoId  String
  userId        String
  name          String
  fullName      String
  description   String?
  language      String?
  languageColor String?
  stars         Int      @default(0)
  forks         Int      @default(0)
  watchers      Int      @default(0)
  issues        Int      @default(0)
  pullRequests  Int      @default(0)
  commits       Int      @default(0)
  contributors  Int      @default(0)
  size          Int      @default(0)
  topics        String[] @default([])
  isPrivate     Boolean  @default(false)
  url           String
  repoCreatedAt DateTime
  repoUpdatedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  archivedAt    DateTime?
  prMetrics     PullRequestMetric[]

  @@unique([userId, githubRepoId])
  @@index([userId])
  @@index([userId, language])
  @@index([userId, stars(sort: Desc)])
  @@index([userId, forks(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("repositories")
}

model PullRequestMetric {
  id                  String     @id @default(uuid())
  repositoryId        String
  prNumber            Int
  authorLogin         String
  createdAt           DateTime
  firstReviewedAt     DateTime?
  mergedAt            DateTime?
  reviewCommentsCount Int        @default(0)
  timeToFirstReviewMs Float?
  timeToMergeMs       Float?
  reviewers           Json       @default("[]")
  partial             Boolean    @default(false)
  refreshedAt         DateTime   @updatedAt
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, prNumber])
  @@index([createdAt])
  @@map("pull_request_metrics")
}

model LanguageStat {
  id          String  @id @default(uuid())
  userId      String
  name        String
  color       String?
  percentage  Float   @default(0)
  linesOfCode Int     @default(0)
  repos       Int     @default(0)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("language_stats")
}

model Challenge {
  id          String          @id @default(uuid())
  title       String
  description String
  type        ChallengeType
  difficulty  Difficulty
  xpReward    Int
  target      Int
  icon        String?
  category    String?
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  users       UserChallenge[]

  @@index([expiresAt])
  @@index([category, expiresAt])
  @@map("challenges")
}

model UserChallenge {
  id          String          @id @default(uuid())
  userId      String
  challengeId String
  progress    Int             @default(0)
  isCompleted Boolean         @default(false)
  status      ChallengeStatus @default(IN_PROGRESS)
  completedAt DateTime?
  claimedAt   DateTime?
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, status])
  @@index([status])
  @@map("user_challenges")
}

model Achievement {
  id          String            @id @default(uuid())
  title       String
  description String
  icon        String?
  category    String?
  rarity      Rarity
  target      Int
  xpReward    Int
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  isUnlocked    Boolean     @default(false)
  unlockedAt    DateTime?
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String
  icon        String?
  tier        BadgeTier
  category    String?
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id             String    @id @default(uuid())
  userId         String
  badgeId        String
  earnedAt       DateTime  @default(now())
  credentialJwt  String?   @db.Text
  credentialJwk  Json?
  issuedAt       DateTime?
  badge          Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Battle {
  id                 String       @id @default(uuid())
  challengerId       String
  opponentId         String
  status             BattleStatus @default(PENDING)
  category           String
  challengerScore    Float?
  opponentScore      Float?
  startedAt          DateTime     @default(now())
  endsAt             DateTime
  winnerId           String?
  forfeitedById      String?
  cancellationReason String?
  zkpProofHash       String?
  zkpVerifiedAt      DateTime?
  challenger         User         @relation("BattleChallenger", fields: [challengerId], references: [id])
  opponent           User         @relation("BattleOpponent", fields: [opponentId], references: [id])
  winner             User?        @relation("BattleWinner", fields: [winnerId], references: [id])

  @@index([status, endsAt])
  @@index([challengerId, status])
  @@index([opponentId, status])
  @@map("battles")
}

model Activity {
  githubEventId String?
  id          String       @id @default(uuid())
  userId      String
  type        ActivityType
  title       String
  description String
  repository  String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubEventId])
  @@map("activities")
}

model NotificationOutbox {
  id             String           @id @default(uuid())
  eventKey       String
  userId         String
  type           NotificationType
  title          String
  message        String
  status         String           @default("PENDING")
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventKey, userId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("notification_outbox")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?
  icon      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
  GRANDMASTER
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  SEASONAL
}

enum ChallengeStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  LEGENDARY
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum BattleStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  FORFEITED
}

enum NotificationType {
  ACHIEVEMENT
  CHALLENGE
  BATTLE
  FRIEND
  SYSTEM
  LEVEL_UP
}

enum ActivityType {
  COMMIT
  PULL_REQUEST
  ISSUE
  REVIEW
  STAR
  FORK
  ACHIEVEMENT
  LEVEL_UP
  BATTLE
  CHALLENGE
}

model GithubUser {
  id              String   @id @default(uuid())
  githubId        String   @unique
  username        String   @unique
  name            String?
  avatarUrl       String?
  bio             String?
  company         String?
  location        String?
  country         String?  
  primaryLanguage String?
  followers       Int      @default(0)
  following       Int      @default(0)
  publicRepos     Int      @default(0)
  totalStars      Int      @default(0)
  totalForks      Int      @default(0)
  score           Float    @default(0) 
  lastSyncedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([score(sort: Desc)])
  @@index([country, score(sort: Desc)])
  @@map("github_users")
}

model LeaderboardCache {
  id          String   @id @default(uuid())
  category    String   @unique
  data        Json
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("leaderboard_caches")
}

model XpTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  source      String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("xp_transactions")
}

enum StorageTier {
  HOT
  WARM
  COLD
}

model CommitArchive {
  id                  String      @id @default(uuid())
  repositoryId        String
  commitSha           String
  assetType           String      @default("COMMIT") // "COMMIT" | "MATCH_REPLAY"
  tier                StorageTier @default(HOT)
  originalBytes       Int
  compressedBytes     Int
  compressionRatio    Float       @default(1.0)
  storageLocation     String      // Local file path, S3 URL, or Glacier Archive ID
  checksumSha256      String?     // SHA-256 for cryptographic integrity verification
  checksumMd5         String?     // MD5 for S3 ETag verification
  restorationStatus   String?     // IDLE | RESTORING | RESTORED
  restorationProgress Float?      // 0.0 - 100.0%
  restoredAt          DateTime?
  accessCount         Int         @default(0)
  lastAccessedAt      DateTime    @default(now())
  archivedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([repositoryId, commitSha])
  @@index([repositoryId])
  @@index([tier])
  @@index([lastAccessedAt])
  @@map("commit_archives")
}

model StorageTierMetrics {
  id                      String   @id @default(uuid())
  recordedAt              DateTime @default(now())
  totalAssets             Int
  hotTierCount            Int
  warmTierCount           Int
  coldTierCount           Int
  totalOriginalBytes      BigInt   @default(0)
  totalCompressedBytes    BigInt   @default(0)
  totalBytesSaved         BigInt   @default(0)
  estimatedMonthlyCostUsd Float    @default(0.0)
  estimatedSavingsUsd     Float    @default(0.0)
  savingsPercentage       Float    @default(0.0)
  metadata                Json?

  @@index([recordedAt])
  @@map("storage_tier_metrics")
}


model SamlTenantConfig {
  id                  String   @id @default(uuid())
  tenantSlug          String   @unique
  providerName        String   // "okta" | "entra" | "google-workspace" | "custom"
  idpEntityId         String
  idpSsoUrl           String
  idpCertificatePem   String   @db.Text
  spEntityId          String
  defaultRole         String   @default("MEMBER")
  roleMapping         Json?
  wantAssertionsSigned Boolean @default(true)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  RETRYING
  DEAD_LETTER
}

model WebhookSubscription {
  id          String                @id @default(uuid())
  userId      String?
  url         String
  secret      String                // HMAC secret key
  description String?
  events      String[]              // e.g. ["battle.ended", "pr.reviewed", "badge.awarded", "*"]
  status      WebhookStatus         @default(ACTIVE)
  deliveries  WebhookDeliveryLog[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@map("webhook_subscriptions")
}

model WebhookDeliveryLog {
  id             String                @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  statusCode     Int?
  latencyMs      Int?
  attemptCount   Int                   @default(0)
  maxAttempts    Int                   @default(5)
  nextRetryAt    DateTime?
  error          String?
  responseBody   String?               @db.Text
  isDeadLetter   Boolean               @default(false)
  dlqReason      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([isDeadLetter])
  @@index([nextRetryAt])
  @@map("webhook_delivery_logs")
}

enum ShadowSessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DriverSeat {
  MENTOR
  APPRENTICE
}

model MentorshipProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMentor          Boolean           @default(false)
  isApprentice      Boolean           @default(true)
  skills            String[]          @default([])
  targetSkills      String[]          @default([])
  timezone          String            @default("UTC")
  completedSessions Int               @default(0)
  totalHours        Float             @default(0.0)
  isCertifiedMentor Boolean           @default(false)
  certifiedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([isMentor, timezone])
  @@map("mentorship_profiles")
}

model ShadowCodingSession {
  id                String              @id @default(uuid())
  mentorId          String
  apprenticeId      String
  title             String
  description       String?
  status            ShadowSessionStatus @default(SCHEDULED)
  driverSeat        DriverSeat          @default(MENTOR)
  activeFile        String              @default("solution.ts")
  activeLine        Int                 @default(1)
  activeColumn      Int                 @default(1)
  viewportTopLine   Int                 @default(1)
  scratchpadNotes   String?             @db.Text
  durationMinutes   Int                 @default(0)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  mentor            User                @relation("MentorSessions", fields: [mentorId], references: [id])
  apprentice        User                @relation("ApprenticeSessions", fields: [apprenticeId], references: [id])

  @@index([mentorId, status])
  @@index([apprenticeId, status])
  @@map("shadow_coding_sessions")
}

model BattleWhiteboard {
  id          String   @id @default(uuid())
  battleId    String   @unique
  snapshot    Json
  svgExport   String?  @db.Text
  mermaidSpec String?  @db.Text
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([battleId])
  @@map("battle_whiteboards")
}

model SmurfDetectionAudit {
  id               String   @id @default(uuid())
  userId           String
  battleId         String
  smurfProbability Float
  isFlagged        Boolean  @default(false)
  mmrMultiplier    Int      @default(1)
  recommendedTier  String
  featureVector    Json
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([isFlagged, smurfProbability])
  @@map("smurf_detection_audits")
}

model BattlePassSeason {
  id           String   @id @default(uuid())
  seasonNumber Int      @unique
  title        String
  theme        String
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("battle_pass_seasons")
}

model UserBattlePassProgress {
  id              String   @id @default(uuid())
  userId          String
  seasonNumber    Int      @default(1)
  totalXp         Int      @default(0)
  currentTier     Int      @default(1)
  isEliteUnlocked Boolean  @default(false)
  claimedFree     Int[]    @default([])
  claimedElite    Int[]    @default([])
  questProgress   Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@unique([userId, seasonNumber])
  @@index([seasonNumber, totalXp])
  @@map("user_battle_pass_progress")
}

model UserInventoryItem {
  id           String   @id @default(uuid())
  userId       String
  cosmeticCode String
  category     String
  label        String
  rarity       String
  seasonNumber Int
  isPermanent  Boolean  @default(true)
  equipped     Boolean  @default(false)
  unlockedAt   DateTime @default(now())

  @@unique([userId, cosmeticCode])
  @@index([userId, category])
  @@map("user_inventory_items")
}

model CommitSignatureAudit {
  id                    String    @id @default(uuid())
  commitSha             String    @unique
  repositoryId          String?
  authorEmail           String
  verificationType      String    @default("NONE") // 'GPG' | 'SIGSTORE' | 'NONE'
  status                String    // 'VERIFIED_GPG' | 'VERIFIED_SIGSTORE' | 'UNVERIFIED' | 'TAMPERED'
  keyId                 String?   // PGP Key ID or Fulcio Cert Serial
  certificateThumbprint String?
  signerIdentity        String?   // OIDC issuer or PGP user ID
  rekorLogIndex         String?
  rekorIntegratedTime   DateTime?
  verifiedAt            DateTime  @default(now())
  details               String?

  @@index([authorEmail])
  @@index([status])
  @@map("commit_signature_audits")
}

model PulseBitsWallet {
  userId            String   @id
  balance           Int      @default(1000)
  totalWagered      Int      @default(0)
  totalWon          Int      @default(0)
  nonMonetaryPolicy String   @default("VIRTUAL_IN_APP_ONLY_NO_CASH_VALUE")
  updatedAt         DateTime @updatedAt

  @@map("pulse_bits_wallets")
}

model PredictionMarketPool {
  id                  String    @id @default(uuid())
  battleId            String    @unique
  marketType          String    @default("MATCH_WINNER")
  outcomes            Json
  status              String    @default("OPEN")
  matchStartedAt      DateTime
  lockAt              DateTime
  lockedAt            DateTime?
  lockReason          String?
  winningOutcome      String?
  verifiedByJudge     Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([status, lockAt])
  @@map("prediction_market_pools")
}

model PredictionWager {
  id           String   @id @default(uuid())
  poolId       String
  battleId     String
  userId       String
  outcomeKey   String
  stakeBits    Int
  lockedOdds   Float
  payoutBits   Int      @default(0)
  settled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([battleId, userId])
  @@index([poolId, outcomeKey])
  @@map("prediction_wagers")
}

enum GuildRole {
  OWNER
  ADMIN
  MEMBER
}

model Guild {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  tag         String
  description String?
  avatarUrl   String?
  bannerUrl   String?
  ownerId     String
  totalXp     Int           @default(0)
  level       Int           @default(1)
  maxMembers  Int           @default(25)
  isPrivate   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     GuildMember[]
  invites     GuildInvite[]

  @@index([totalXp(sort: Desc)])
  @@index([slug])
  @@map("guilds")
}

model GuildMember {
  id            String    @id @default(uuid())
  guildId       String
  userId        String
  role          GuildRole @default(MEMBER)
  joinedAt      DateTime  @default(now())
  xpContributed Int       @default(0)

  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, role])
  @@map("guild_members")
}

model GuildInvite {
  id         String    @id @default(uuid())
  guildId    String
  inviteCode String    @unique
  expiresAt  DateTime
  maxUses    Int       @default(1)
  usesCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
  @@map("guild_invites")
}

model CompetitiveRating {
  id                         String    @id @default(uuid())
  userId                     String    @unique
  eloRating                  Float     @default(1200.0)
  ratingDeviation            Float     @default(350.0)
  volatility                 Float     @default(0.06)
  placementMatchesRemaining  Int       @default(5)
  peakRating                 Float     @default(1200.0)
  seasonId                   String    @default("season_2026_s1")
  lastMatchAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([eloRating(sort: Desc)])
  @@index([seasonId, eloRating(sort: Desc)])
  @@map("competitive_ratings")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                String   @default("dark")
  accentColor          String   @default("purple")
  colorVisionTheme     String   @default("normal")
  developerTheme       String   @default("default")
  defaultLandingTab    String   @default("dashboard")
  compactTableView     Boolean  @default(false)
  reducedMotion        Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  emailAlerts          Boolean  @default(false)
  soundEffectsEnabled  Boolean  @default(true)
  battleChallenges     Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  achievementUnlocks   Boolean  @default(true)
  leaderboardUpdates   Boolean  @default(true)
  challengeReminders   Boolean  @default(true)
  productUpdates       Boolean  @default(false)
  privacy              String   @default("public")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ZkpSubmissionProof {
  id            String   @id @default(uuid())
  userId        String
  challengeId   String
  proofHash     String   @unique
  publicSignals Json
  verifiedAt    DateTime @default(now())

  @@index([userId])
  @@index([challengeId])
  @@map("zkp_submission_proofs")
}

enum MpcSecretStatus {
  ACTIVE
  RECONSTRUCTED
  ROTATED
  REVOKED
}

model MpcVaultSecret {
  id              String               @id @default(uuid())
  organizationId  String
  name            String               // e.g. "PROD_DEPLOYMENT_MASTER_KEY"
  description     String?
  thresholdK      Int                  // e.g. 3
  totalSharesN    Int                  // e.g. 5
  status          MpcSecretStatus      @default(ACTIVE)
  secretHash      String               // SHA-256 hash of master secret for verification (never stores plain secret)
  shares          MpcShareAllocation[]
  auditProofs     MpcAuditProof[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rotatedAt       DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("mpc_vault_secrets")
}

model MpcShareAllocation {
  id               String         @id @default(uuid())
  secretId         String
  secret           MpcVaultSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  shareIndex       Int            // 1 to n (x coordinate in GF256)
  allocatedTo      String         // Admin user ID
  shareFingerprint String         // SHA-256 fingerprint of the share
  encryptedShare   String?        // Ephemeral or encrypted share envelope if stored
  isBurned         Boolean        @default(false)
  burnedAt         DateTime?
  allocatedAt      DateTime       @default(now())

  @@unique([secretId, shareIndex])
  @@index([allocatedTo])
  @@map("mpc_share_allocations")
}

model MpcAuditProof {
  id                  String         @id @default(uuid())
  secretId            String
  secret              MpcVaultSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  action              String         // "SPLIT" | "RECONSTRUCT" | "BURN" | "ROTATE"
  performedBy         String         // Admin user ID
  thresholdMet        Boolean        @default(false)
  participatingShares Int[]          // e.g. [1, 3, 5]
  proofSignature      String         // HMAC-SHA256 audit proof signature
  metadata            Json?          // Nonce, IP, client device, timestamp
  createdAt           DateTime       @default(now())

  @@index([secretId])
  @@index([performedBy])
  @@map("mpc_audit_proofs")
}
